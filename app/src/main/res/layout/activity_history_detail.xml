<?xml version="1.0" encoding="utf-8"?>
<!-- One past session: what it was, its verdict and the per-rep results table. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".history.HistoryDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            tools:text="VO2 5x5" />

        <TextView
            android:id="@+id/detailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Wed 19 Nov 2026, 18:04 · FTP 200 W · Recovery: Building" />

        <TextView
            android:id="@+id/detailVerdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            tools:text="4 of 5 reps on target · Recovery 95 / 101 / 110 / 98 / 120 s" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:scrollbars="none">

            <TableLayout
                android:id="@+id/resultsTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shrinkColumns="*" />
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
