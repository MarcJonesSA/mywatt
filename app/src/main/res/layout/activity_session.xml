<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".session.SessionActivity">

    <!-- The live page. Its background is tinted by band during a rep. -->
    <LinearLayout
        android:id="@+id/livePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <!-- Top: block name and rep count. -->
        <TextView
            android:id="@+id/blockTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:letterSpacing="0.04"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            tools:text="Rep" />

        <TextView
            android:id="@+id/repLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_horizontal"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            tools:text="Rep 2 of 3" />

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Rep 2/3 · 250 W · avg 243 W · 0:41 left" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Centre: smoothed watts, large, with the target under it. -->
        <TextView
            android:id="@+id/wattsValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:text="@string/no_reading"
            android:textColor="@color/text_primary"
            android:textSize="128sp"
            android:textStyle="bold"
            tools:text="247" />

        <TextView
            android:id="@+id/wattsUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:letterSpacing="0.16"
            android:text="@string/unit_watts"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/targetValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            tools:text="Target 250 W" />

        <TextView
            android:id="@+id/gearNag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:letterSpacing="0.08"
            android:text="@string/session_gear_up"
            android:textColor="@color/zone_4"
            android:textSize="22sp"
            android:visibility="invisible"
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Below: heart rate and gear, then the recovery line during a recovery. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hrValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.04"
                android:text="@string/hr_unknown"
                android:textColor="@color/text_secondary"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="HR 158" />

            <TextView
                android:id="@+id/gearValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.04"
                android:text="@string/gear_unknown"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="Gear 12" />
        </LinearLayout>

        <TextView
            android:id="@+id/recoveryLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:visibility="invisible"
            tools:text="Recover · HR 158 → 142 · 0:47"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/minuteDrops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:visibility="invisible"
            tools:text="-15 | -11"
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom: time left (or elapsed in a gated recovery), then Pause and End. -->
        <TextView
            android:id="@+id/timeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:letterSpacing="0.16"
            android:text="@string/session_time_left"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/timeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:text="@string/no_reading"
            android:textColor="@color/text_primary"
            android:textSize="56sp"
            android:textStyle="bold"
            tools:text="4:32" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pauseButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/action_pause"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/endButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/action_end"
                android:textSize="16sp"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- The results page, shown once the session has ended. -->
    <ScrollView
        android:id="@+id/resultsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/resultsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="@string/session_complete"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/verdictText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                tools:text="All 3 reps on target · Recovery 60 / 65 / 72 s" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:scrollbars="none">

                <TableLayout
                    android:id="@+id/resultsTable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shrinkColumns="*" />
            </HorizontalScrollView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareResultsButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/action_share_log"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:backgroundTint="@color/surface_variant"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/doneButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/action_done"
                    android:textSize="16sp"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
